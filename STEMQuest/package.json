{
  "name": "stemquest",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "node scripts/serve.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "seed:generate": "node scripts/seed.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests scripts *.ts *.mjs",
    "preview": "node scripts/serve.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "framer-motion": "14.3.0",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.10",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
